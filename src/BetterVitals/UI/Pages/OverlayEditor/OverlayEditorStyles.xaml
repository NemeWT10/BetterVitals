<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:BetterVitals.UI"
                    xmlns:c="clr-namespace:BetterVitals.UI.Controls"
                    xmlns:ex="clr-namespace:BetterVitals.UI.Explain">
    <!--
      Overlay editor styles (OvEd.*). Only DynamicResource (the dictionary also loads without an Application in tests).
        OvEd.Tile        ToggleButton  friendly parameter tile; checked = accent tint + order badge (Tag = "1", "2"…)
        OvEd.AddTile     Button        dashed "All sensors…" tile
        OvEd.Corner      RadioButton   corner button over the monitor mock (Content = icon)
        OvEd.Option      RadioButton   selectable row card (font list, anchors)
        OvEd.Anchor      RadioButton   one of the 9 anchor cells
        OvEd.Swatch      Button        color dot of the color popover (Background = color)
        OvEd.ColorButton Button        opens the color popover (Content built in code)
        OvEd.Row         Border        items list row
        OvEd.SmallField  TextBox       compact number / hex field
        OvEd.PickerItem  ListBoxItem   row container of the sensor picker (headers are not interactive)
        OvEd.PickerRow   DataTemplate  sensor picker row (PickerRow): hardware header or sensor + live value + switch
    -->

    <!-- drag handle: six dots (24×24 grid like Icons.xaml) -->
    <StreamGeometry x:Key="OvEd.Icon.Grip">M9,6.5 H9.01 M15,6.5 H15.01 M9,12 H9.01 M15,12 H15.01 M9,17.5 H9.01 M15,17.5 H15.01</StreamGeometry>

    <Style x:Key="OvEd.Tile" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Width" Value="172"/>
        <Setter Property="Padding" Value="12,10,12,11"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ui:Motion.HoverLift" Value="2"/>
        <Setter Property="ui:Motion.Toggle" Value="BadgeScale.ScaleX:0.4&gt;1|1&gt;1:260:back;BadgeScale.ScaleY:0.4&gt;1|1&gt;1:260:back;Ring.Opacity:0&gt;1|1&gt;0:160"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <Border x:Name="Ring" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Accent}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Focus" CornerRadius="14" Margin="-3" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.AccentText}" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Badge" MinWidth="20" Height="20" CornerRadius="10" Padding="5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0"
                                Background="{DynamicResource Brush.AccentFill}" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BadgeScale"/>
                            </Border.RenderTransform>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            <Setter TargetName="Badge" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OvEd.AddTile" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Width" Value="172"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="ui:Motion.HoverLift" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Dash" RadiusX="12" RadiusY="12" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1.2" StrokeDashArray="4 3"/>
                        <Border x:Name="Focus" CornerRadius="14" Margin="-3" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.AccentText}" Opacity="0"/>
                        <ContentPresenter Margin="12,10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Brush.AccentText}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a corner of the monitor mock: dark glass button with a white icon, checked = accent fill -->
    <Style x:Key="OvEd.Corner" TargetType="RadioButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
        <Setter Property="ui:Motion.Toggle" Value="S.ScaleX:0.8&gt;1:240:back;S.ScaleY:0.8&gt;1:240:back"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="S"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Bd" CornerRadius="9" Background="#99101420" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                        <Border x:Name="On" CornerRadius="9" Background="{DynamicResource Brush.AccentFill}" Opacity="0"/>
                        <Border x:Name="Focus" CornerRadius="11" Margin="-3" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.AccentText}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CC101420"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- selectable row card (font list): checked = accent ring + check -->
    <Style x:Key="OvEd.Option" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ui:Motion.Toggle" Value="CheckScale.ScaleX:0.4&gt;1|1&gt;1:240:back;CheckScale.ScaleY:0.4&gt;1|1&gt;1:240:back"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Brush.BgAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        </Border>
                        <Border x:Name="Focus" CornerRadius="12" Margin="-3" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.AccentText}" Opacity="0"/>
                        <Border x:Name="Check" Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                Background="{DynamicResource Brush.AccentFill}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CheckScale"/>
                            </Border.RenderTransform>
                            <c:Icon Data="{DynamicResource Icon.Check}" Size="10" StrokeThickness="1.8" Foreground="{DynamicResource Brush.OnAccent}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- one cell of the 3×3 anchor picker: a dot that becomes an accent square -->
    <Style x:Key="OvEd.Anchor" TargetType="RadioButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ui:Motion.Toggle" Value="DotScale.ScaleX:0.5&gt;1:220:back;DotScale.ScaleY:0.5&gt;1:220:back"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="5" Background="Transparent" Margin="1"/>
                        <Border x:Name="Dot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Brush.TextFaint}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="DotScale"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Focus" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.AccentText}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.TextDim}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="16"/>
                            <Setter TargetName="Dot" Property="Height" Value="11"/>
                            <Setter TargetName="Dot" Property="CornerRadius" Value="3"/>
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.AccentFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OvEd.Swatch" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.5" Opacity="0"/>
                        <Ellipse Margin="3" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OvEd.ColorButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="6,4,10,4"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="9" Background="{DynamicResource Brush.BgAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OvEd.Row" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.BgAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="OvEd.SmallField" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="SelectionOpacity" Value="0.45"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Brush.BgAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextFaint}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"/>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OvEd.PickerItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="10,5" Margin="0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsHeader}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="Focusable" Value="False"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="OvEd.PickerRow">
        <Grid>
            <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,10,0,2" Visibility="Collapsed">
                <c:Icon Size="15" c:Res.Icon="{Binding IconKey}" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <DockPanel x:Name="Row" Background="Transparent">
                <CheckBox DockPanel.Dock="Right" Style="{DynamicResource Switch}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="12,0,0,0"
                          VerticalAlignment="Center" Focusable="True"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="12.5" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextDim}" Typography.NumeralAlignment="Tabular"/>
                <c:Icon Size="15" c:Res.Icon="{Binding IconKey}" Foreground="{DynamicResource Brush.TextFaint}" Margin="22,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                               ex:Explain.Sensor="{Binding Sensor}"/>
                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter TargetName="Header" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Row" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
