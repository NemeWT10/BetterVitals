<UserControl x:Class="BetterVitals.UI.Dev.GalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:BetterVitals.Localization"
             xmlns:c="clr-namespace:BetterVitals.UI.Controls">
    <!-- Developer gallery of the base styles (snapshots only): what wave-2 pages are built from. -->
        <StackPanel x:Name="Body">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr dev.gallery}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr dev.gallery.subtitle}" Margin="1,4,0,22"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Check}" Size="15" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:Tr dev.primary}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Export}" Size="15" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:Tr dev.secondary}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr dev.ghost}" Margin="0,0,10,10"/>
                        <Button Style="{StaticResource IconButton}" Margin="0,0,6,10">
                            <c:Icon Data="{StaticResource Icon.Refresh}" Size="16"/>
                        </Button>
                        <ToggleButton Style="{StaticResource IconButton}" IsChecked="True" Margin="0,0,6,10">
                            <c:Icon Data="{StaticResource Icon.Star}" Size="16"/>
                        </ToggleButton>
                        <Button Style="{StaticResource IconButton}" Margin="0,0,6,10">
                            <c:Icon Data="{StaticResource Icon.Trash}" Size="16"/>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Content="{l:Tr common.undo}" Margin="6,0,0,10" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="True" Margin="0,0,14,10"/>
                        <CheckBox Style="{StaticResource Switch}" Margin="0,0,24,10"/>
                        <Border Style="{StaticResource SegmentHost}" Margin="0,0,16,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="g1" IsChecked="True" Content="{l:Tr dev.simple}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="g1" Content="{l:Tr dev.advanced}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="g2" Content="15 min"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="g2" Content="1 h" IsChecked="True"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="g2" Content="24 h"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="g2" Content="7 d"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SearchBox}" Tag="{l:Tr dev.search}"/>
                        <TextBox Grid.Column="2" Style="{StaticResource Field}" Text="{l:Tr dev.field}"/>
                        <ComboBox Grid.Column="4" Style="{StaticResource Combo}" SelectedIndex="0" MinWidth="0">
                            <ComboBoxItem Content="Inter"/>
                            <ComboBoxItem Content="Geist"/>
                        </ComboBox>
                    </Grid>
                    <DockPanel Margin="0,16,0,0">
                        <TextBlock Text="{l:Tr dev.range}" Style="{StaticResource Text.Label}" Width="90" VerticalAlignment="Center"/>
                        <Slider Style="{StaticResource Slider}" Minimum="50" Maximum="200" Value="120"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Tr nav.sensors}"/>
            <Border Style="{StaticResource Card}" Padding="8">
                <ListBox x:Name="Rows" Style="{StaticResource BareList}" Height="190"/>
            </Border>

            <WrapPanel>
                <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="True" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Series.0}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Core (Tctl/Tdie)"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="True" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Series.1}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="GPU Hot Spot"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Series.2}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Memory"/>
                    </StackPanel>
                </ToggleButton>
                <Border Style="{StaticResource Tag}" Margin="6,0,8,8">
                    <TextBlock Text="°C"/>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                    <TextBlock Text="RTX 5080"/>
                </Border>
            </WrapPanel>

            <WrapPanel x:Name="Swatches" Margin="0,8,0,0"/>
        </StackPanel>
</UserControl>
