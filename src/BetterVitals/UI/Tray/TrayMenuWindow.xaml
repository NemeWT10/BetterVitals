<Window x:Class="BetterVitals.UI.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BetterVitals.Localization"
        xmlns:c="clr-namespace:BetterVitals.UI.Controls"
        Title="BetterVitals" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True" Left="-32000" Top="-32000">
    <Grid Margin="16">
        <Border x:Name="Card" CornerRadius="14" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.PanelBorder}"
                BorderThickness="1" Padding="6" MinWidth="268">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.4" Color="{DynamicResource Color.Shadow}"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Border.RenderTransform>
            <StackPanel>
                <DockPanel Margin="10,8,10,10">
                    <Image Source="{StaticResource Logo.Image.Small}" Width="24" Height="24"/>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextFaint}"/>
                    <TextBlock Text="BetterVitals" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.PanelText}"/>
                </DockPanel>

                <!-- the overlay switch: toggles in place, the menu stays open -->
                <Button x:Name="OverlayItem" Style="{StaticResource MenuRow}" Click="Overlay_Click">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Overlay}" Size="17" Margin="0,0,11,0" Foreground="{DynamicResource Brush.AccentText}"/>
                        <CheckBox x:Name="OverlaySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="20,-3,-3,-3"
                                  IsHitTestVisible="False" Focusable="False"/>
                        <TextBlock Text="{l:Tr tray.overlay}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource MenuRow}" Click="EditOverlay_Click">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Sliders}" Size="17" Margin="0,0,11,0" Foreground="{DynamicResource Brush.AccentText}"/>
                        <TextBlock Text="{l:Tr tray.editOverlay}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <Rectangle Style="{StaticResource Ov.Separator}"/>

                <Button Style="{StaticResource MenuRow}" Click="Panel_Click">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Dashboard}" Size="17" Margin="0,0,11,0" Foreground="{DynamicResource Brush.AccentText}"/>
                        <TextBlock Text="{l:Tr tray.panel}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource MenuRow}" Click="Settings_Click">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Settings}" Size="17" Margin="0,0,11,0" Foreground="{DynamicResource Brush.PanelTextDim}"/>
                        <TextBlock Text="{l:Tr tray.settings}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource MenuRow}" Click="About_Click">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Info}" Size="17" Margin="0,0,11,0" Foreground="{DynamicResource Brush.PanelTextDim}"/>
                        <TextBlock Text="{l:Tr tray.about}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <Rectangle Style="{StaticResource Ov.Separator}"/>

                <Button Style="{StaticResource MenuRow}" Click="Exit_Click">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Power}" Size="17" Margin="0,0,11,0" Foreground="{DynamicResource Brush.PanelTextDim}"/>
                        <TextBlock Text="{l:Tr tray.exit}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
