<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- App.xaml is a Page: Program.Main creates the App, calls InitializeComponent and Run. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>BetterVitals.Program</StartupObject>
    <AssemblyName>BetterVitals</AssemblyName>
    <RootNamespace>BetterVitals</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe icon (Explorer, taskbar, Start, Apps); windows without an Icon of their own take it from the exe.
         Drawn by tools\IconGen from UI\Brand\BrandMark.cs. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Lean runtime (lessons from BetterShot / BetterNotepad, re-measured by perf-guard): workstation GC without the
         background GC thread, conserve memory, no dynamic PGO. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BetterVitals.Tests" />
  </ItemGroup>

  <!-- Single-file publish: WPF's native libraries are NOT self-extracted to %TEMP% (an elevated process must never load
       DLLs from a user-writable folder); they ride inside as resources and NativeRuntime writes them to a safe folder.
       Measured in BetterShot: an uncompressed bundle keeps the tray far lighter. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- the WPF native libraries of the runtime pack this publish uses (same version as the bundled runtime) -->
  <Target Name="BvEmbedWpfNative" BeforeTargets="PrepareResourceNames" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <BvWpfNativeDir>$(NuGetPackageRoot)microsoft.windowsdesktop.app.runtime.$(RuntimeIdentifier)\$(BundledNETCoreAppPackageVersion)\runtimes\$(RuntimeIdentifier)\native\</BvWpfNativeDir>
    </PropertyGroup>
    <ItemGroup>
      <BvWpfNative Include="$(BvWpfNativeDir)*_cor3.dll" />
      <EmbeddedResource Include="@(BvWpfNative)" LogicalName="BetterVitals.Native.%(Filename)%(Extension)" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
    <Error Condition="'@(BvWpfNative)' == ''" Text="WPF native libraries not found in $(BvWpfNativeDir) — the single-file exe would not start." />
    <Message Importance="high" Text="BetterVitals: embedding WPF native libraries: @(BvWpfNative->'%(Filename)%(Extension)', ', ')" />
  </Target>

  <!-- Settings > About shows the repository's license and third-party notices (embedded, never out of date). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="BetterVitals.LICENSE.txt" Link="UI\About\LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="BetterVitals.THIRD-PARTY-NOTICES.md" Link="UI\About\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterVitals.Core\BetterVitals.Core.csproj" />
    <ProjectReference Include="..\BetterVitals.Sensors\BetterVitals.Sensors.csproj" />
    <ProjectReference Include="..\BetterVitals.History\BetterVitals.History.csproj" />
    <ProjectReference Include="..\BetterVitals.Fps\BetterVitals.Fps.csproj" />
    <ProjectReference Include="..\BetterVitals.Overlay\BetterVitals.Overlay.csproj" />
    <ProjectReference Include="..\BetterVitals.Platform\BetterVitals.Platform.csproj" />
  </ItemGroup>

</Project>
