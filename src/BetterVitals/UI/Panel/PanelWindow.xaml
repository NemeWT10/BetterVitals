<Window x:Class="BetterVitals.UI.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BetterVitals.Localization"
        xmlns:c="clr-namespace:BetterVitals.UI.Controls"
        xmlns:t="clr-namespace:BetterVitals.UI.Toasts"
        Title="BetterVitals" Width="1120" Height="740" MinWidth="780" MinHeight="540"
        Background="{DynamicResource Brush.WindowBg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- navigation rail -->
        <DockPanel Grid.Column="0" Margin="12,0,10,14">
            <DockPanel DockPanel.Dock="Top" Height="54" Margin="8,0,0,6">
                <Image Source="{StaticResource Logo.Image}" Width="22" Height="22" VerticalAlignment="Center"/>
                <TextBlock Text="BetterVitals" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,1"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- status card -->
            <Border DockPanel.Dock="Bottom" CornerRadius="12" Padding="12,10" Background="{DynamicResource Brush.NavHover}">
                <DockPanel>
                    <c:Icon x:Name="StatusIcon" Data="{StaticResource Icon.Record}" Size="15" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="VersionText" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextFaint}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel x:Name="Nav" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </DockPanel>

        <!-- page layer -->
        <Border Grid.Column="1" Margin="0,44,0,0" CornerRadius="12,0,0,0" Background="{DynamicResource Brush.Layer}"
                BorderBrush="{DynamicResource Brush.LayerBorder}" BorderThickness="1,1,0,0" ClipToBounds="True">
            <Grid>
                <ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False"/>
                <t:ToastHost x:Name="Toasts"/>
            </Grid>
        </Border>

        <!-- caption buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="{l:Tr window.minimize}">
                <c:Icon Data="{StaticResource Icon.Window.Minimize}" Size="16" StrokeThickness="1"/>
            </Button>
            <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="{l:Tr window.maximize}">
                <c:Icon x:Name="MaxIcon" Data="{StaticResource Icon.Window.Maximize}" Size="16" StrokeThickness="1"/>
            </Button>
            <Button Style="{StaticResource ChromeCloseButton}" Click="Close_Click" ToolTip="{l:Tr window.close}">
                <c:Icon Data="{StaticResource Icon.Close}" Size="16" StrokeThickness="1"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
